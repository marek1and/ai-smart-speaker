[Unit]
Description=WirePlumber session manager (system mode)
After=pipewire.service
Requires=pipewire.service

[Service]
User=speaker
SupplementaryGroups=audio
Environment=PIPEWIRE_RUNTIME_DIR=/run/pipewire
Environment=XDG_RUNTIME_DIR=/run/pipewire
# persist stream/device volumes across reboots on the data partition
Environment=XDG_STATE_HOME=/data/state
ExecStart=/usr/bin/wireplumber
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
