#!/bin/sh

echo "PREINIT: Start"

PATH=/sbin:/bin:/usr/sbin:/usr/bin
if {CREATE_MOUNT_DIRS}; then
    mount -o remount,rw /

    mkdir -p /proc
    mkdir -p /sys
    mkdir -p /run
    mkdir -p /var/run
    mkdir -p {OVERLAYFS_ETC_MOUNT_POINT}
fi

mount -t proc proc /proc
mount -t sysfs sysfs /sys

[ -z "$CONSOLE" ] && CONSOLE="/dev/console"

BASE_OVERLAY_ETC_DIR={OVERLAYFS_ETC_MOUNT_POINT}/overlay-etc
UPPER_DIR=$BASE_OVERLAY_ETC_DIR/upper
WORK_DIR=$BASE_OVERLAY_ETC_DIR/work
LOWER_DIR=$BASE_OVERLAY_ETC_DIR/lower

# {OVERLAYFS_ETC_MOUNT_POINT} holds the /etc overlay and is not in fstab, so
# nothing else checks it. Clean: returns at once; after a power cut it replays
# the journal. Nobody can answer a prompt here, so what -p leaves is fixed
# with -y.
e2fsck -p {OVERLAYFS_ETC_DEVICE} >/dev/null 2>&1
fsck_rc=$?
if [ $fsck_rc -ge 4 ]; then
    echo "PREINIT: e2fsck -p {OVERLAYFS_ETC_DEVICE} exit $fsck_rc, running e2fsck -y" > /dev/kmsg
    e2fsck -y {OVERLAYFS_ETC_DEVICE} >/dev/null 2>&1
    fsck_rc=$?
fi
[ $fsck_rc -ne 0 ] && echo "PREINIT: e2fsck {OVERLAYFS_ETC_DEVICE} exit $fsck_rc" > /dev/kmsg

if mount -n -t {OVERLAYFS_ETC_FSTYPE} \
    -o {OVERLAYFS_ETC_MOUNT_OPTIONS} \
    {OVERLAYFS_ETC_DEVICE} {OVERLAYFS_ETC_MOUNT_POINT}
then
    mkdir -p $UPPER_DIR
    mkdir -p $WORK_DIR

    if {OVERLAYFS_ETC_EXPOSE_LOWER}; then
        mkdir -p $LOWER_DIR

        # provide read-only access to original /etc content
        mount -o bind,ro /etc $LOWER_DIR
    fi

    mount -n -t overlay \
        -o upperdir=$UPPER_DIR \
        -o lowerdir=/etc \
        -o workdir=$WORK_DIR \
        -o index=off,xino=off,redirect_dir=off,metacopy=off \
        $UPPER_DIR /etc || \
            echo "PREINIT: Mounting etc-overlay failed!"
else
    echo "PREINIT: Mounting </data> failed!"
fi

umount /sys
umount /proc

echo "PREINIT: done; starting </sbin/init>"
exec {SBIN_INIT_NAME}
