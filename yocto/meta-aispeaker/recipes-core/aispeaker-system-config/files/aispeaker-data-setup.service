[Unit]
Description=Create writable data layout on /data
RequiresMountsFor=/data
After=local-fs.target
Before=var-lib-NetworkManager.mount var-lib-bluetooth.mount
Before=NetworkManager.service bluetooth.service

[Service]
Type=oneshot
ExecStart=/usr/sbin/aispeaker-data-setup
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
