[Unit]
Description=Confirm the running system slot once the speaker is healthy
After=multi-user.target
Wants=multi-user.target

[Service]
# exec, not oneshot: a oneshot holds the boot transaction open for the whole
# check (60 s of app uptime), so "Startup finished" reported over a minute
Type=exec
ExecStart=/usr/sbin/aispeaker-health-check

[Install]
WantedBy=multi-user.target
