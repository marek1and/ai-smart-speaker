      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "title": "Wake Word Detections",
      "description": "Wake word triggers by context: idle = normal wake, barge_in = interrupting AI response, re_listen = re-triggered while already listening",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "increase(speaker_wake_word_detections_total[$__rate_interval])",
          "legendFormat": "{{context}}",
          "refId": "A"
        }
      ]
    },
