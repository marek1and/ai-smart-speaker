[Unit]
Description=AI Smart Speaker Service
After=network.target pipewire.service wireplumber.service mopidy.service
Requires=pipewire.service wireplumber.service
# Wants, not Requires: the app runs without Mopidy (no radio/music), and
# a stop or restart of Mopidy must not take the assistant down with it.
Wants=mopidy.service

[Service]
Type=simple
WorkingDirectory=/opt/ai-smart-speaker
ExecStart=/opt/ai-smart-speaker/.venv/bin/python main.py

Restart=on-failure
RestartSec=5

# Logs landing in journalctl (e.g. journalctl --user -u ai-smart-speaker -f)
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
