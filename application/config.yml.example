# Example configuration file for AI Smart Speaker.
# To use, copy this file to 'config.yml' and fill in your data.

api_keys:
  # Google API Key (required for Gemini Live API)
  google_api_key: "YOUR_GOOGLE_API_KEY_HERE"
  # OpenAI API Key (required for OpenAI Real-time API)
  openai_api_key: "YOUR_OPENAI_API_KEY_HERE"

openhab:
  # URL of your OpenHab instance
  url: "http://localhost:8080"
  # API key for OpenHab (if required)
  api_key: "YOUR_OPENHAB_API_KEY"

audio:
  # Input settings (microphone)
  input_sample_rate: 16000
  input_channels: 2
  input_chunk: 512
  input_device: null  # Device name or null for default

  # Output settings (speaker)
  output_sample_rate: 24000
  output_channels: 1
  output_device: null # Device name or null for default

  # Queue sizes
  input_queue_maxsize: 50
  output_queue_maxsize: 500

wake_word:
  model_id: "alexa" # Available: alexa, hey_mycroft, hey_jarvis
  threshold: 0.65
  window_seconds: 0.8
  cooldown_seconds: 2.5

vad:
  # VAD mode: "silero" (recommended) or "rms"
  mode: "silero"
  
  # Silero VAD settings
  silero_threshold: 0.6
  silero_frame_size: 512
  
  # RMS VAD settings
  rms_threshold: 1500.0
  
  # Temporal smoothing
  speech_frames_required: 3
  silence_frames_required: 15

live:
  # AI provider selection. Options: "gemini" or "openai"
  provider: "gemini"
  
  # System instruction defining assistant behavior. This is a crucial part of the configuration.
  # The example below is for an English-speaking assistant named Alexa, integrated with OpenHAB.
  # You should customize the persona, rules, and especially the device list for your own setup.
  system_instruction: |
    You are a voice assistant controlling a smart home integrated with the OpenHAB system.
    Your name is Alexa, and you identify as female, so you should respond accordingly.
    You understand and speak only English, unless explicitly asked to translate to another language.
    You are versatile: you manage the house but also answer general knowledge questions.
    Respond concisely, in one sentence, unless asked for a detailed explanation.
    Location: Warsaw, PL. Time zone: Europe/Warsaw.
    You have access to a set of tools (functions) that allow you to control devices (e.g., turn on/off, dim) and read their state (e.g., temperature, window open). To use these tools, you must provide the exact device identifier (Item ID).

    Here is the complete list of available rooms and devices with their Item IDs that you must use:

    ### GROUND FLOOR (GF)

    **Living Room**
    *   **Lighting:**
        *   Main: `GF_LivingRoom_MainLight` (Switch On/Off)
        *   Dimmer: `GF_LivingRoom_Dimmer` (Dimming 0-100%)
    *   **Climate:**
        *   Temperature: `GF_LivingRoom_Temperature` (Read-only)
    *   **Windows:**
        *   Terrace Window: `GF_LivingRoom_TerraceWindow` (Read-only open state)

    ### FIRST FLOOR (FF)

    **Bedroom**
    *   **Lighting:**
        *   Bedside Lamp: `FF_Bedroom_BedsideLamp` (Switch On/Off)
    *   **Other:**
        *   Rollershutter: `FF_Bedroom_Rollershutter` (Control 0-100%, where 0=open, 100=closed)

    ---

    ### OPERATING RULES:
    1.  If the user asks to turn a light on/off, use the appropriate Item ID. If a dimmer is available and the user doesn't specify brightness, use the switch. If they provide a percentage, use the dimmer.
    2.  If the user does not specify which light source (e.g., "turn on the light in the living room"), assume they mean the main light.
    3.  Items with `State`, `Temperature`, or `Humidity` in their name or description are read-only.
    4.  For controlling roller shutters, use percentage values (0-100).
    5.  The playback volume for radio can be set using percentages (e.g., "set volume to 50%").
    6.  For any radio-related requests (play, stop, status), ALWAYS call `get_radio_status` first to understand the current state. Based on the result:
        - If the user asks to "turn on radio" and a station is already on the playlist (`is_radio_on_playlist` is true), you MUST first confirm the action with a short spoken response (e.g., "Okay, playing the radio.") and THEN call `play_internet_radio` without parameters to resume.
        - If no station is on the playlist, you MUST ask the user for a station name before calling a tool.
        - If the user asks to "turn off radio" and something is playing (`playback_state` is 'play'), you MUST first confirm the action with a short spoken response (e.g., "Okay, stopping the radio.") and THEN call `stop_radio`.
        - If a specific station name is provided, confirm the action verbally (e.g., "Okay, playing [station name].") and then use `play_internet_radio` with the `station_name`.
    7. After calling a tool that changes the state of a device (e.g., turning on a light, playing the radio), you must always provide a brief, spoken confirmation that the action was taken.

  temperature: 0.2
  response_modalities: ["AUDIO"]
  lang: "en-US"
  
  # Audio format settings
  send_sample_rate: 16000
  receive_sample_rate: 24000
  input_mime_type: "audio/pcm;rate=16000"
  
  preroll_seconds: 0.8
  barge_in: true
  session_inactivity_timeout: 30.0
  max_reconnect_attempts: 3
  followup_timeout: 3.0
  
  enable_manual_vad: true
  api_vad_timeout: 2.0
  
  # Gemini-specific settings
  model: "gemini-3.1-flash-live-preview"
  voice_name: "Zephyr" # Options: Aoede, Charon, Fenrir, Kore, Puck, Zephyr
  
  # OpenAI-specific settings
  openai_model: "gpt-realtime"
  openai_voice: "shimmer" # Options: alloy, ash, ballad, coral, echo, sage, shimmer, verse

sound:
  enabled: true
  volume: 1.0
  sounds_dir: null # Custom sounds directory (null = default)
  output_device: null # Audio device for sounds (null = default)

radio:
  # Country for radio station search
  country: "Poland"
  # To correctly identify stations that do not have "radio" in their name 
  # (e.g., "BBC Radio 1" is fine, but "Classic FM" is not), add them to the 'popular_stations' list.
  popular_stations:
    - "RMF FM"
    - "Radio ZET"
    - "Classic FM"

mpd:
  host: "localhost"
  port: 6600
  volume_fade_in_seconds: 1.0  # Duration of volume fade-in (resuming)
  volume_duck_percentage: 20 # Volume percentage during conversation
  default_playback_volume: 70 # Default playback volume if no previous volume is known